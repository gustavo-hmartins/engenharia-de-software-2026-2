graph LR
    subgraph Cliente ["Frontend (Web Responsiva)"]
        UI[Interface do Usuário / SPA]
    end

    subgraph Backend ["Backend (Monólito Modular)"]
        subgraph Borda ["Camada de Borda"]
            Controllers[Controllers / Rotas API REST]
        end
        subgraph Dominio ["Camada de Domínio"]
            Services[Serviços & Regras de Negócio]
        end
        subgraph Persistencia ["Camada de Persistência"]
            Repositories[Repositórios & ORM]
        end
        Controllers --> Services
        Services --> Repositories
    end

    subgraph DB ["Banco de Dados Relacional"]
        Tables[(Tabelas: Usuários, Perfis, Carteiras, Ativos)]
    end

    UI -->|HTTP / JSON - API REST| Controllers
    Repositories -->|Consultas / Transações SQL| DB
